SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62 SLAVE_SPI_PORT=DISABLE MASTER_SPI_PORT=ENABLE SLAVE_PARALLEL_PORT=DISABLE;

LOCATE      COMP "clk25" SITE "P3";
IOBUF       PORT "clk25" IO_TYPE=LVCMOS33;
FREQUENCY   PORT "clk25" 25 MHZ;

LOCATE COMP "LED" SITE "U16";
IOBUF PORT "LED" IO_TYPE=LVCMOS25;

#### P2 ####

# Looking outwards from the FPGA towards P2, PMOD1 is on the left side and PMOD2 is on the right side
# PMOD2 is not used it shares pin with LED

#### P2 PMOD1 (closest to HDMI) ####

# This represents ui

LOCATE COMP "P2_PMOD1[0]" SITE "J20"; # P2_16 = PR23C = J20
IOBUF  PORT "P2_PMOD1[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P2_PMOD1[1]" SITE "L18"; # P2_17 = PR29C = L18
IOBUF  PORT "P2_PMOD1[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P2_PMOD1[2]" SITE "M18"; # P2_18 = PR29D = M18
IOBUF  PORT "P2_PMOD1[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P2_PMOD1[3]" SITE "N17"; # P2_19 = PR35A = N17
IOBUF  PORT "P2_PMOD1[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P2_PMOD1[4]" SITE "G20"; # P2_15 = PR17D = G20
IOBUF  PORT "P2_PMOD1[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P2_PMOD1[5]" SITE "K20"; # P2_14 = PR23D = K20
IOBUF  PORT "P2_PMOD1[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P2_PMOD1[6]" SITE "L20"; # P2_13 = PR26A = L20
IOBUF  PORT "P2_PMOD1[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P2_PMOD1[7]" SITE "N18"; # P2_12 = PR32C = N18
IOBUF  PORT "P2_PMOD1[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

#### P2 PMOD2 (farthest from HDMI) ####

# Not used, overlaps with LED

#### P3 PMOD1 (farthest from HDMI) ####

# This represents uo

LOCATE COMP "P3_PMOD1[0]" SITE "D1"; # P3_16 = PL17B = D1
IOBUF  PORT "P3_PMOD1[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P3_PMOD1[1]" SITE "C1"; # P3_17 = PL17A = C1
IOBUF  PORT "P3_PMOD1[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P3_PMOD1[2]" SITE "C2"; # P3_18 = PL14D = C2
IOBUF  PORT "P3_PMOD1[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P3_PMOD1[3]" SITE "E3"; # P3_19 = PL11B = E3
IOBUF  PORT "P3_PMOD1[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P3_PMOD1[4]" SITE "E2"; # P3_15 = PL23D = E2
IOBUF  PORT "P3_PMOD1[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P3_PMOD1[5]" SITE "D2"; # P3_14 = PL17C = D2
IOBUF  PORT "P3_PMOD1[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P3_PMOD1[6]" SITE "B1"; # P3_13 = PL14B = B1
IOBUF  PORT "P3_PMOD1[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P3_PMOD1[7]" SITE "A3"; # P3_12 = PL5C = A3
IOBUF  PORT "P3_PMOD1[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

#### P3 PMOD2 (closest to HDMI) ####

# This represents uio

LOCATE COMP "P3_PMOD2[0]" SITE "C17"; # P3_25 = PT60B = C17
IOBUF  PORT "P3_PMOD2[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P3_PMOD2[1]" SITE "B18"; # P3_26 = PT62B = B18
IOBUF  PORT "P3_PMOD2[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P3_PMOD2[2]" SITE "B20"; # P3_27 = PT67B = B20
IOBUF  PORT "P3_PMOD2[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P3_PMOD2[3]" SITE "F20"; # P3_28 = PR17C = F20
IOBUF  PORT "P3_PMOD2[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P3_PMOD2[4]" SITE "A18"; # P3_6 = PT65A = A18
IOBUF  PORT "P3_PMOD2[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P3_PMOD2[5]" SITE "A19"; # P3_5 = PT67A = A19
IOBUF  PORT "P3_PMOD2[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P3_PMOD2[6]" SITE "B19"; # P3_4 = PT65B = B19
IOBUF  PORT "P3_PMOD2[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "P3_PMOD2[7]" SITE "D20"; # P3_3 = PR14C = D20
IOBUF  PORT "P3_PMOD2[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;


